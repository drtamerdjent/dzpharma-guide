// DzPharma Guide — Prisma schema
// Local mirror of the Supabase `public.medications` table (used when Supabase
// credentials are not configured, e.g. local preview / offline development).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Medication {
  id                    String   @id
  dci                   String
  nom_commercial        String
  laboratoire           String
  forme_galenique       String
  dosage                String
  prix_approximatif_dzd Float?
  taux_cnas             Int      @default(0)
  is_available          Boolean  @default(true)
  created_at            DateTime @default(now())

  @@index([dci])
  @@index([nom_commercial])
  @@map("medications")
}

// Crowd-sourced shortage reports ("Signaler une rupture").
// In production with Supabase, mirror this table as public.shortage_reports.
model ShortageReport {
  id            String   @id @default(cuid())
  medication_id String
  reporter      String   @default("Contributeur anonyme")
  note          String?
  reported_at   DateTime @default(now())

  @@index([medication_id])
  @@index([reported_at])
  @@map("shortage_reports")
}

// Doctor accounts (comptes médecins). Premium is attached to the account,
// not to the browser — payments (BaridiMob → WhatsApp) activate it server-side.
model Doctor {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  specialty     String?
  phone         String?
  isPremium     Boolean   @default(false)
  premiumSource String?
  premiumUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions DoctorSession[]
  payments PaymentRequest[]

  @@map("doctors")
}

// One session per device. Business rule: a doctor may stay logged in on
// AT MOST 2 devices simultaneously (anti credential-sharing, per the
// business plan). A 3rd device must sign out other devices first.
model DoctorSession {
  id                String   @id @default(cuid())
  token             String   @unique
  doctorId          String
  deviceFingerprint String
  deviceLabel       String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, deviceFingerprint])
  @@index([doctorId])
  @@map("doctor_sessions")
}

// BaridiMob transfer -> WhatsApp proof -> manual activation (<= 1 h).
// In production the activation step is done by an operator; the demo
// endpoint simulates it.
model PaymentRequest {
  id          String    @id @default(cuid())
  reference   String    @unique
  doctorId    String
  method      String    @default("BARIDIMOB")
  amountDzd   Float     @default(3600)
  senderName  String
  senderPhone String
  // PENDING | ACTIVATED | REJECTED
  status      String    @default("PENDING")
  note        String?
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("payment_requests")
}

// Telegram bot users ("DzPharma Express"). In production with Supabase,
// mirror this table as public.telegram_users:
//   create table telegram_users (id uuid pk default gen_random_uuid(), telegram_id text unique not null,
//     first_name text, username text, plan text not null default 'FREE',
//     searches_today int not null default 0, last_search_date text,
//     created_at timestamptz default now());
model TelegramUser {
  id             String   @id @default(cuid())
  telegramId     String   @unique
  firstName      String?
  username       String?
  // FREE | PREMIUM
  plan           String   @default("FREE")
  searchesToday  Int      @default(0)
  // "YYYY-MM-DD" (local server day of the last search)
  lastSearchDate String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("telegram_users")
}
